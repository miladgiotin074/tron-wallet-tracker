# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=

# آیدی عددی ادمین(ها)، چندتایی را با ویرگول جدا کنید
TELEGRAM_ADMIN_IDS=

# کلید Tronscan — از پنل ترون‌اسکن (با کلید TronGrid فرق دارد)
TRONSCAN_API_KEY=

# کلید TronGrid فقط به‌عنوان پشتیبان لیست واریز ولت
TRONGRID_API_KEY=

# فاصلهٔ چک کردن ولت‌ها (میلی‌ثانیه)
POLL_INTERVAL_MS=2500

# مسیر ذخیره ولت‌ها — در Render روی دیسک دائمی بگذارید: /data
# DATA_DIR=/data
